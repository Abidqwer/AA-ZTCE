FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates apt-utils \
    swtpm tpm2-tools libtss2-tcti-swtpm0 softhsm2 libsofthsm2 libtpms0 libgomp1 libstdc++6 libseccomp2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app/
CMD ["bash", "run_virtual_range.sh"]
